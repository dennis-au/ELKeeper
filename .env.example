# Copy to .env and set every secret before starting the stack.
APP_BIND=0.0.0.0
APP_PORT=8080
APP_SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SSH_KEY_FILE=/absolute/path/to/managed_nodes_ed25519
SSH_KNOWN_HOSTS_FILE=/absolute/path/to/managed_nodes_known_hosts
HOST_APP_DATA_DIR=./data
HOST_APP_CONFIG_DIR=./config
HOST_PLAYBOOK_DIR=./playbooks
CONTROL_IMAGE=elastic-control-plane:latest
CONTROL_CONTAINER_NAME=elastic-control-plane
ANSIBLE_FORKS=10
FIREWALLD_MODE=disabled
